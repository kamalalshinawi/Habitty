{
  "expo": {
    "name": "Habitty",
    "slug": "Habitty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/appIcon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "visible": "sticky-immersive"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamalalshinawi.Habitty"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kamalalshinawi.Habitty"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a47a35a0-510a-4481-b4ad-964fb3d1ad5b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a47a35a0-510a-4481-b4ad-964fb3d1ad5b"
    }
  }
}
